{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokencue.dev/contracts/provider-manifest.schema.json",
  "type": "object",
  "required": ["version", "baseline", "providers"],
  "properties": {
    "version": { "const": 1 },
    "baseline": { "type": "string" },
    "providers": {
      "type": "array",
      "minItems": 67,
      "maxItems": 67,
      "items": {
        "type": "object",
        "required": ["id", "name", "auth", "capabilities"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+$" },
          "name": { "type": "string", "minLength": 1 },
          "auth": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "capabilities": {
            "type": "object",
            "required": ["usage", "cost", "status", "balance", "multiAccount", "plugins"],
            "additionalProperties": { "type": "boolean" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
