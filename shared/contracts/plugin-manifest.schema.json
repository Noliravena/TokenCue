{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokencue.dev/contracts/plugin-manifest.schema.json",
  "title": "TokenCue provider plugin manifest v1",
  "description": "JSON-compatible fields passed to defineProvider(...). fetchUsage is a required function and is validated by each native runtime.",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "endpoints", "settings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "icon": {
      "type": "object",
      "required": ["monogram", "tint"],
      "properties": {
        "monogram": { "type": "string", "minLength": 1, "maxLength": 3 },
        "tint": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      },
      "additionalProperties": false
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          { "type": "string", "format": "uri", "pattern": "^https://" },
          {
            "type": "object",
            "required": ["setting", "policy"],
            "properties": {
              "setting": { "$ref": "#/$defs/settingKey" },
              "policy": { "enum": ["https", "https-or-loopback-http"] }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "auth": {
      "type": ["object", "null"],
      "required": ["type", "secret"],
      "properties": {
        "type": { "enum": ["bearer", "x-api-key", "header", "authorization-scheme"] },
        "secret": { "$ref": "#/$defs/settingKey" },
        "header": { "type": "string", "minLength": 1, "maxLength": 128 },
        "scheme": { "type": "string", "minLength": 1, "maxLength": 32 }
      },
      "additionalProperties": false
    },
    "settings": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["key", "title", "type"],
        "properties": {
          "key": { "$ref": "#/$defs/settingKey" },
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "subtitle": { "type": "string", "maxLength": 256 },
          "type": { "enum": ["plain", "secure"] }
        },
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "array",
      "items": { "enum": ["browser-cookies"] },
      "uniqueItems": true
    },
    "cookieDomains": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-zA-Z0-9.-]+$" },
      "uniqueItems": true
    },
    "limits": {
      "type": "object",
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 30000, "default": 10000 },
        "maxResponseBytes": { "type": "integer", "minimum": 1024, "maximum": 5242880, "default": 1048576 }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "settingKey": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" }
  },
  "additionalProperties": false
}
